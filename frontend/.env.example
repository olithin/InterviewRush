# Copy to .env.local and restart `npm run dev` after any change.
# Use the same host you type in the browser: localhost and 127.0.0.1 need matching redirect URIs in Google.
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=replace-with-long-random-openssl-hex-32-chars
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (type: Web application)
#   Authorized JavaScript origins: http://localhost:3000
#   Authorized redirect URIs:      http://localhost:3000/api/auth/callback/google
# If you see ?error=OAuthSignin, the server could not start the Google flow — check credentials,
# redirect URI, and that the dev machine can reach https://accounts.google.com (see terminal with npm run dev).
